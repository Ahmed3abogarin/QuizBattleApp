<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.vtol.quizbattleapp.fragments.HomeFragment"
        tools:layout="@layout/fragment_home"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_startGameFragment"
            app:destination="@id/startGameFragment"
            app:enterAnim="@anim/from_right" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/startGameFragment"
        android:name="com.vtol.quizbattleapp.fragments.StartGameFragment"
        tools:layout="@layout/start_game_fragment"
        android:label="StartGameFragment" >
        <argument
            android:name="quizId"
            app:argType="string" />
        <argument
            android:name="roomId"
            app:argType="string" />
        <action
            android:id="@+id/action_startGameFragment_to_quizFragment"
            app:destination="@id/quizFragment"
            app:enterAnim="@anim/from_right" />
        <action
            android:id="@+id/action_startGameFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:exitAnim="@anim/anim_from_left" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.vtol.quizbattleapp.fragments.SplashFragment"
        android:label="SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.vtol.quizbattleapp.fragments.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/anim_from_bottom" />
    </fragment>
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.vtol.quizbattleapp.fragments.QuizFragment"
        android:label="QuizFragment"
        tools:layout="@layout/fragment_quiz">
        <argument
            android:name="quizId"
            app:argType="string" />
        <argument
            android:name="roomId"
            app:argType="string" />
        <action
            android:id="@+id/action_quizFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
        <action
            android:id="@+id/action_quizFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.vtol.quizbattleapp.fragments.ResultFragment"
        android:label="ResultFragment"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="quizId"
            app:argType="string" />
        <argument
            android:name="roomId"
            app:argType="string" />
        <action
            android:id="@+id/action_resultFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
</navigation>